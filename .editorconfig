# ============================================================
# 编辑器与语言规范（全仓库单一来源）
#
# 为什么需要它：此前缩进、using 排序、命名等约定只存在于"逐文件模仿"里，
# 全靠编辑器默认值与作者习惯，差异要到评审时才暴露。本文件把它们成文，
# 与两份既有配置共同构成完整约定（冲突时：换行符以 .gitattributes 为准，
# 编译/分析开关以 Directory.Build.props 为准，本文件管编辑器侧的表达）。
#
# 结构参考 TaskRunner 仓库的同名文件，并按本仓库实际做了取舍：
#   - 换行符策略与 .gitattributes 完全一致（仓库一律 LF，bat/cmd/ps1 例外 CRLF）；
#   - 命名与语言约定是对现有代码风格"成文"（_camel 私有字段、文件范围命名空间等），
#     不引入需要全仓库返工的新风格；
#   - CA1848 / 测试 CA1707 与 Directory.Build.props 的 NoWarn 保持同源，
#     取舍说明见彼处，这里只让 IDE 的波浪线与构建口径一致。
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 中行尾两个空格是硬换行语义，不清理
[*.md]
trim_trailing_whitespace = false

# Windows 批处理必须 CRLF（cmd 对 LF 的解析问题），与 .gitattributes 一致
[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.{csproj,props,targets,slnx,xml,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4

# ---- 语言规范 ----
dotnet_style_qualification_for_field = false
dotnet_style_readonly_field = true:warning
dotnet_sort_system_directives_using = true

# var 使用：类型明显时用 var；类型不明显时显式写类型（现有代码风格成文）
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:suggestion

# ---- 命名：私有字段 _camel ----
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ---- 现代 C# 偏好 ----
csharp_style_expression_bodied_methods = false:silent
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_switch_expression = true:warning

# 与 Directory.Build.props 的 NoWarn 同源：不强制用源生成器 LoggerMessage
# 代替 ILogger 扩展方法（量级小、可读性优先的取舍说明见彼处）
dotnet_diagnostic.CA1848.severity = none

# 集成/单元测试用下划线命名描述场景（如 Success_should_not_carry_an_error），
# CA1707 会对此告警 —— 测试代码豁免，与各测试 csproj 的 NoWarn 同源
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
