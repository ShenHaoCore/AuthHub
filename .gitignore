# ---------------------------------------------------------------- 数据库与运行时文件
# SQLite 本地开发库（由 EnsureCreated 生成）
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# 应用生成的日志目录
logs/
*.log

# ---------------------------------------------------------------- 密钥与证书（绝不入库）
# RSA / 签名证书
*.pfx
*.p12
*.snk
*.key
*.pem
*.crt
*.cer
# Data Protection 密钥环（默认落在用户目录，此处兜底所有常见位置）
keys/
DataProtection-Keys/
dp-keys/
# .NET 用户机密
secrets.json
*.secrets.json
# 环境变量文件（含敏感值）
.env
.env.*
!.env.example

# ---------------------------------------------------------------- 本地临时文件
oidapi*.txt
oidval.txt
nuget-*.txt
*.tmp
*.bak
*.orig
*~
*.swp
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 智能体本地状态
# .workbuddy/ 存的是智能体在本工作区的记忆（每日日志 + 长期笔记）。
# 它属于**开发机上的本地状态**：多人协作时会各自积累、互相冲突，
# 而且内容里常带个人路径，因此不入库。
# 注意目录本身不要删 —— 工具会持续往里写。
.workbuddy/
