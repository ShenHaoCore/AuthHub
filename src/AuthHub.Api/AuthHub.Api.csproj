<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AuthHub.Api</RootNamespace>
    <UserSecretsId>authhub-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      OpenAPI 文档生成器：.NET 9 起由框架自带（AddOpenApi / MapOpenApi）。
      它原生读取 [Tags] / [EndpointSummary] / [EndpointDescription] 这些端点元数据，
      且输出路径默认就是 Scalar 约定的 openapi/{documentName}.json，
      因此不再需要 Swashbuckle 之类的第三方生成器。
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />

    <!--
      Scalar：OpenAPI 文档的交互式 UI（替代 Swagger UI）。
      包本身零第三方依赖（nuspec 里各 TFM 的依赖组都是空的），UI 资源（JS/CSS）内嵌在
      程序集里、由本地路由提供，不从 CDN 加载 —— 因此在离线/内网环境可用，
      也不会被本站的 CSP（script-src 'self'）拦截。它只消费一个文档 URL，与生成器无关。
    -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />

    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />

    <!--
      EF Core 工具（dotnet ef migrations / database update）要求「启动项目」引用 Design 包，
      而 Infrastructure 里的引用带 PrivateAssets=all，不会流动到 Api。
      同时它让 DesignTimeDbContextFactory 之外的常规路径（从启动项目解析 DbContext）也可用。
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthHub.Application\AuthHub.Application.csproj" />
    <ProjectReference Include="..\AuthHub.Infrastructure\AuthHub.Infrastructure.csproj" />
  </ItemGroup>

</Project>
