<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AuthHub.Api</RootNamespace>
    <UserSecretsId>authhub-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      只引 SwaggerGen（而非完整的 Swashbuckle.AspNetCore）：这里只用它生成 OpenAPI 文档 JSON，
      交互式 UI 已改用 Scalar，因此不再需要 Swashbuckle 自带的 SwaggerUI 静态资源。
    -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />

    <!--
      Scalar：OpenAPI 文档的交互式 UI（替代 Swagger UI）。
      对 net8.0 目标没有任何传递依赖，UI 资源（JS/CSS）内嵌在程序集里、由本地路由提供，
      不从 CDN 加载 —— 因此在离线/内网环境可用，也不会被本站的 CSP（script-src 'self'）拦截。
    -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />

    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />

    <!--
      EF Core 工具（dotnet ef migrations / database update）要求「启动项目」引用 Design 包，
      而 Infrastructure 里的引用带 PrivateAssets=all，不会流动到 Api。
      同时它让 DesignTimeDbContextFactory 之外的常规路径（从启动项目解析 DbContext）也可用。
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthHub.Application\AuthHub.Application.csproj" />
    <ProjectReference Include="..\AuthHub.Infrastructure\AuthHub.Infrastructure.csproj" />
  </ItemGroup>

</Project>
