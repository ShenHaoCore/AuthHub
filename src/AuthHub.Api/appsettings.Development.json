{
  // Kestrel:Endpoints 在这里定义部署用端口（5001/5000）。它优先于
  // launchSettings 与 ASPNETCORE_URLS —— 所以并行开发的 local-sqlite 档案
  // 用 Kestrel__Endpoints__*__Url 环境变量覆盖（环境变量优先级更高）。
  // 不要直接改这里来换端口：这会影响所有走 systemd / 服务方式启动的实例。

  "Database": {
    "Provider": "SqlServer"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=AuthHub.Dev;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },

  "AuthHub": {
    "Issuer": "https://localhost:5001/",
    "PublicBaseUrl": "https://localhost:5001",

    "Security": {
      "RequireHttps": true
    },

    "Email": {
      "Provider": "ethereal-auto"
    },

    "Features": {
      "EnablePasswordFlow": true,
      "EnableApiDocs": true
    },

    "Cors": {
      "AllowedOrigins": [ "https://localhost:3000", "https://localhost:5002" ]
    },

    "Seeding": {
      "Enabled": true,
      "MigrateOnStartup": true
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 300,
      "LoginRequestsPerMinute": 50
    },

    "Seed": {
      "AdminPassword": "Admin@12345",
      "DemoPassword": "Alice@12345",
      "WebClientSecret": "web-secret",
      "M2mClientSecret": "m2m-secret"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      },
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  }
}
