{
  "Database": {
    "Provider": "SqlServer"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=AuthHub.Dev;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },

  "AuthHub": {
    "Issuer": "https://localhost:5001/",
    "PublicBaseUrl": "https://localhost:5001",

    "Security": {
      "RequireHttps": true
    },

    // 本机看邮件：不真发出网，登录 ethereal.email 查看（仅 Development 允许）
    "Email": {
      "Provider": "ethereal-auto"
    },

    "Features": {
      "EnablePasswordFlow": true,
      "EnableApiDocs": true
    },

    "Cors": {
      "AllowedOrigins": [ "https://localhost:3000", "https://localhost:5002" ]
    },

    "Seeding": {
      "Enabled": true,
      "MigrateOnStartup": true
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 300,
      "LoginRequestsPerMinute": 50
    },

    "Seed": {
      "AdminPassword": "Admin@12345",
      "DemoPassword": "Alice@12345",
      "WebClientSecret": "web-secret",
      "M2mClientSecret": "m2m-secret"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      },
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  }
}
