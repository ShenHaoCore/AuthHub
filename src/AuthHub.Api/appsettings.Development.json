{
  // 注意：不要在本文件里配置 Kestrel:Endpoints。配置端点的优先级高于
  // launchSettings 的 applicationUrl 与 ASPNETCORE_URLS，硬编码端口会让
  // 「本地 dotnet run / F5」无法改端口 —— WSL 部署占着 5000/5001 的
  // localhost 转发时，启动会直接 AddressInUse 崩溃。端口一律由
  // Properties/launchSettings.json 的档案决定（local-sqlite 档用 5003/5002
  // 与部署实例并行，数据库走零配置 SQLite）。

  "Database": {
    "Provider": "SqlServer"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=AuthHub.Dev;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },

  "AuthHub": {
    "Issuer": "https://localhost:5001/",
    "PublicBaseUrl": "https://localhost:5001",

    "Security": {
      "RequireHttps": true
    },

    "Email": {
      "Provider": "ethereal-auto"
    },

    "Features": {
      "EnablePasswordFlow": true,
      "EnableApiDocs": true
    },

    "Cors": {
      "AllowedOrigins": [ "https://localhost:3000", "https://localhost:5002" ]
    },

    "Seeding": {
      "Enabled": true,
      "MigrateOnStartup": true
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 300,
      "LoginRequestsPerMinute": 50
    },

    "Seed": {
      "AdminPassword": "Admin@12345",
      "DemoPassword": "Alice@12345",
      "WebClientSecret": "web-secret",
      "M2mClientSecret": "m2m-secret"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
