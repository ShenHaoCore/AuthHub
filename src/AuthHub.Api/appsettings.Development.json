{
  // 本机开发配置。ASPNETCORE_ENVIRONMENT=Development 时加载；个人机器差异写不入库的 appsettings.Local.json。

  // 与 appsettings.json 同值。重复写一份是为了动本机这份就能单独切换（如临时改用 SQLite 调试）。
  "Database": {
    "Provider": "SqlServer"
  },

  "ConnectionStrings": {
    // 用 (local) 走共享内存：本机实例 TCP/IP 默认关闭，写 localhost,1433 会超时。
    // 用 Windows 认证（Trusted_Connection）省掉明文口令，开发机当前账号通常已是 sysadmin。
    "DefaultConnection": "Server=(local);Database=AuthHub.Dev;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },

  "AuthHub": {
    "Issuer": "https://localhost:5001/",

    "Security": {
      "RequireHttps": true
    },

    "Features": {
      "EnablePasswordFlow": true,
      "EnableApiDocs": true
    },

    "Cors": {
      "AllowedOrigins": [ "https://localhost:3000", "https://localhost:5002" ]
    },

    "Seeding": {
      "Enabled": true,
      "MigrateOnStartup": true
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 300,
      "LoginRequestsPerMinute": 50
    },

    "Seed": {
      "AdminPassword": "Admin@12345",
      "DemoPassword": "Alice@12345",
      "WebClientSecret": "web-secret",
      "M2mClientSecret": "m2m-secret"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      },
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  }
}
