{
  // 生产环境的非敏感配置，入库可 review、可被 CI 校验。敏感值（连接串、证书、种子口令）一律由
  // 环境变量/密钥库注入——写进这里会进 git 历史，删不掉。此处只写与其它环境不同的项。

  "AuthHub": {
    "Security": {
      "RequireHttps": true
    },

    "Features": {
      // 生产不暴露接口文档。受保护环境打开它会让进程直接起不来（启动护栏 Fail 项）。
      "EnableApiDocs": false,

      // 资源所有者密码流程（ROPC）让本服务经手用户明文口令，生产默认关闭。
      "EnablePasswordFlow": false
    },

    // 生产既不自动迁移也不自动播种。迁移交给发布流程显式执行；播种含演示账号与公开密钥。
    "Seeding": {
      "Enabled": false,
      "MigrateOnStartup": false
    },

    // 前后端分离部署时列来源；为空则收紧成 https://localhost（不是放开），见 CorsExtensions。
    "Cors": {
      "AllowedOrigins": []
    }
  },

  // 生产用 Information。调试级别日志在生产既没价值又放大磁盘与采集成本。
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
