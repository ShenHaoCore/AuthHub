{
  // 非敏感生产覆盖；连接串/证书/口令用环境变量或密钥库注入。

  "AuthHub": {
    "Security": {
      "RequireHttps": true
    },

    "Features": {
      "EnableApiDocs": false,
      "EnablePasswordFlow": false
    },

    "Seeding": {
      "Enabled": false,
      "MigrateOnStartup": false
    },

    "Cors": {
      "AllowedOrigins": []
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
