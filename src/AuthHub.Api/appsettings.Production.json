{
  "AuthHub": {
    "Security": {
      "RequireHttps": true
    },

    "Features": {
      "EnableApiDocs": false,
      "EnablePasswordFlow": false
    },

    "Seeding": {
      "Enabled": false,
      "MigrateOnStartup": false
    },

    "Cors": {
      "AllowedOrigins": []
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
