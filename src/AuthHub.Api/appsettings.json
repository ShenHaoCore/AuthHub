{
  // 所有环境共用的默认值。环境特有取值写 appsettings.{环境}.json，本机差异写不入库的
  // appsettings.Local.json。本文件用 // 注释（.NET 配置提供程序支持），勿改回 _comment_* 伪键。

  // 留假地址而非空串：空串只会抛模糊异常，假地址会被启动护栏明确指出。真正连接串由环境变量注入。
  "ConnectionStrings": {
    "DefaultConnection": "Server=prod-db-server;Database=AuthHub;User Id=sa;Password=CHANGE_ME_IN_SECRET_STORE;Encrypt=True;TrustServerCertificate=False;"
  },

  // 取值：SqlServer（生产，走迁移+3次重试）/ Sqlite（本机与集成测试，EnsureCreated 建表）。
  // 拼错（如 Sqllite）不会报错，会被当成 SqlServer。
  "Database": {
    "Provider": "SqlServer"
  },

  "AuthHub": {
    "Issuer": "https://authhub.example.com/",

    "Security": {
      "RequireHttps": true,

      // 会话 Cookie、防伪令牌、MFA 票据的密钥环目录。留空用平台默认；容器中该位置常在卷外，
      // 重建后密钥环重置（全员掉线 + 表单 400）。生产请指向挂载卷，多实例需共享。
      "DataProtectionKeysPath": "",

      // 部署在反代/网关后置 true，否则 RemoteIpAddress 与 IsHttps 会判错。
      "TrustForwardedHeaders": false,

      // 反代网段（CIDR，须带前缀长度）。.NET 默认只信任 loopback，不在此列表的 X-Forwarded-* 会被静默忽略。
      "KnownNetworks": [],

      // 单个反代地址（裸 IP）。配了任一项即整体替换 loopback 信任范围，而非叠加。
      "KnownProxies": [],

      // 上游地址不固定时置 true，等同信任任何直连来源。须由网络层保证仅网关可达本服务。
      "TrustAnyProxy": false
    },

    // 角色→权限归属。只能把已存在权限发给角色（权限点编译在服务端），覆盖出厂默认
    // （RolePermissionMap.cs）。权限名须与 AuthHubConstants.Permissions 常量逐字一致，启动时校验。
    "RolePermissions": {
      "Administrator": [ "clients.manage", "scopes.manage", "users.manage", "roles.manage", "tokens.revoke", "audit.read" ],
      "UserManager": [ "users.manage", "tokens.revoke" ],
      "Auditor": [ "audit.read" ],
      "User": []
    },

    "Features": {
      // EnableApiDocs 不在此给值：其默认值随环境变（Development 开、其余关，写在 Program.cs），
      // 此处一旦写死就会架空环境感知默认值。各环境自行在 appsettings.{环境}.json 配置。
      "EnablePasswordFlow": false
    },

    // 第三方登录（OAuth）。Enabled=false 时登录页不渲染对应按钮，也不注册认证 handler；
    // 启用却不给凭据会在启动期直接失败（见 ExternalAuthenticationExtensions）。
    // 回调地址需在提供商后台注册：{对外地址}/signin-github 与 {对外地址}/signin-google。
    // ClientId/ClientSecret 属于机密，经环境变量或密钥库注入（如 AuthHub__Authentication__GitHub__ClientId）。
    "Authentication": {
      // 第三方登录邮箱白名单：[] 表示不限制（生产默认）；填入邮箱后，只有「提供商已验证邮箱」
      // 命中名单的外部账号能登录或建立绑定，GitHub/Google 同时生效，已绑定账号也受限（fail-closed）。
      // 用途是开发/演示环境只放指定测试账号，不要当长期访问控制；邮箱比较忽略大小写。
      "AllowedEmails": [],

      "GitHub": { "Enabled": false, "ClientId": "", "ClientSecret": "" },
      "Google": { "Enabled": false, "ClientId": "", "ClientSecret": "" },

      // 企业微信扫码登录（自建应用 SSO）。CorpId 是企业 ID，AgentId/Secret 来自管理后台的自建应用；
      // 回调地址 {对外地址}/signin-wecom 的域名必须在企业微信后台配置为可信域名（需所有权验证），
      // 因此 localhost 无法联调，只能在有公网域名的环境启用。Secret 经环境变量注入
      //（AuthHub__Authentication__WeCom__Secret）。
      "WeCom": { "Enabled": false, "CorpId": "", "AgentId": "", "Secret": "" }
    },

    "Cors": {
      "AllowedOrigins": []
    },

    "Seeding": {
      "Enabled": false,
      "MigrateOnStartup": false,

      // 生产跑种子数据的二次确认。种子含演示账号与公开密钥，生产即使 Enabled=true 也须再开此开关。
      "AllowInProduction": false
    },

    "Keys": {
      "SigningCertificatePath": "",
      "SigningCertificatePassword": ""
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 60,
      "LoginRequestsPerMinute": 10
    },

    "Seed": {
      "AdminPassword": "",
      "DemoPassword": "",
      "WebClientSecret": "",
      "M2mClientSecret": ""
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/authhub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]

    // 生产建议接入 Seq：在 Using 加 Serilog.Sinks.Seq，WriteTo 追加 { "Name": "Seq", "Args": { "serverUrl": "..." } }。
  },

  "AllowedHosts": "*"
}
