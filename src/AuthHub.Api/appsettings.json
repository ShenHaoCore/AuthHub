{
  "ConnectionStrings": {
    "DefaultConnection": "Server=prod-db-server;Database=AuthHub;User Id=sa;Password=CHANGE_ME_IN_SECRET_STORE;Encrypt=True;TrustServerCertificate=False;"
  },

  "Database": {
    "Provider": "SqlServer"
  },

  "AuthHub": {
    "Issuer": "https://authhub.example.com/",

    "Security": {
      "RequireHttps": true
    },

    "_comment_RolePermissions": "角色 → 权限归属。这是授权三层里唯一可改配置就生效的一层：权限点（能力目录）与授权策略仍编译在服务端，本段只能把已存在的权限发给角色，发明不出新能力。列出的角色覆盖出厂默认（见 Domain/Constants/RolePermissionMap.cs），未列出的沿用默认。权限名必须与 AuthHubConstants.Permissions 里的常量逐字一致（区分大小写），写错会在启动时直接失败。",

    "RolePermissions": {
      "Administrator": [ "clients.manage", "scopes.manage", "users.manage", "roles.manage", "tokens.revoke", "audit.read" ],
      "UserManager": [ "users.manage", "tokens.revoke" ],
      "Auditor": [ "audit.read" ],
      "User": []
    },

    "Features": {
      "EnablePasswordFlow": false,
      "EnableApiDocs": false
    },

    "Cors": {
      "AllowedOrigins": []
    },

    "Seeding": {
      "Enabled": false,
      "MigrateOnStartup": false
    },

    "Keys": {
      "SigningCertificatePath": "",
      "SigningCertificatePassword": ""
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 60,
      "LoginRequestsPerMinute": 10
    },

    "Seed": {
      "AdminPassword": "",
      "DemoPassword": "",
      "WebClientSecret": "",
      "M2mClientSecret": ""
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/authhub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],

    "_comment_Seq": "生产建议接入 Seq / ELK：在 Serilog:Using 增加 Serilog.Sinks.Seq，并在 WriteTo 中追加 { \"Name\": \"Seq\", \"Args\": { \"serverUrl\": \"http://seq:5341\" } }。开发环境默认不开启，避免没有 Seq 实例时产生重试噪音。"
  },

  "AllowedHosts": "*"
}
