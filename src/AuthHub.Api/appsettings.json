{
  // 共用默认 → appsettings.{环境}.json →（Development）User Secrets → 环境变量 / 命令行。

  "ConnectionStrings": {
    "DefaultConnection": "Server=prod-db-server;Database=AuthHub;User Id=sa;Password=CHANGE_ME_IN_SECRET_STORE;Encrypt=True;TrustServerCertificate=False;"
  },

  "Database": {
    "Provider": "SqlServer"
  },

  "AuthHub": {
    "Issuer": "https://authhub.example.com/",
    // 邮件绝对链接基址；空则用 Issuer，再空才用请求 Host
    "PublicBaseUrl": "",

    // RFC 8707 资源标识白名单：只有登记在这里的绝对 URI 才能出现在
    // 授权请求 / 令牌请求的 resource 参数里，并写进令牌的 aud。未登记 → invalid_target。
    // 新增一项需要重启（OpenIddict 的校验集合是启动时快照的）。
    // 例：接入 MCP Server 时填 [ "https://mcp.example.com/mcp" ]
    // 注意内置的 authhub-api 不要写在这里：它不是绝对 URI，会启动报错；
    // 它作为 aud 由 Scope 的 Resources 带出（见 AuthHubSeeder）。
    "Resources": [],

    // CIMD（Client ID Metadata Document）动态客户端注册 —— 让 Claude Desktop、Cursor 这类
    // 通用 MCP 客户端不必事先在后台登记就能接入。默认关闭：打开之后本服务会主动向
    // client_id 指向的 HTTPS 地址发起请求，这是全仓库唯一"由匿名请求驱动出站连接"的入口。
    // 每一项限制的含义见 AuthHub.Application/Options/CimdOptions.cs。
    "Cimd": {
      "Enabled": false,
      // 元数据缓存有效期（小时）。到期后下一次授权请求重新拉取；拉取失败时降级用缓存。
      "RefreshIntervalHours": 24,
      // 单次拉取（含全部重定向跳）的超时秒数。
      "FetchTimeoutSeconds": 5,
      "MaxRedirects": 3,
      "MaxMetadataBytes": 65536,
      // 自动注册客户端可申请的 scope，与元数据里声明的取交集。
      // 刻意不含 api:read / api:write / admin：那是 AuthHub 自身 API 的授权范围，
      // 不该由一台外部 MCP 服务器替用户决定。
      "AllowedScopes": [ "openid", "profile", "email", "roles" ],
      // 过渡期把 SSRF 面收窄到已知厂商的白名单（精确匹配 Host）。为空表示不限制。
      "AllowedHosts": [],
      // 授予自动注册客户端的资源标识（RFC 8707 的 rsrc: 权限）。
      // 为空表示沿用 AuthHub:Resources 全集 —— 资源本身已是服务端白名单。
      "AllowedResources": [],
      // 自动注册的客户端没人审核过，必须让用户看见"谁在要哪些权限"。
      "RequireConsent": true
    },

    "Security": {
      "RequireHttps": true,
      "DataProtectionKeysPath": "",
      "TrustForwardedHeaders": false,
      "KnownNetworks": [],
      "KnownProxies": [],
      "TrustAnyProxy": false
    },

    "RolePermissions": {
      "Administrator": [ "clients.manage", "scopes.manage", "users.manage", "roles.manage", "tokens.revoke", "audit.read" ],
      "UserManager": [ "users.manage", "tokens.revoke" ],
      "Auditor": [ "audit.read" ],
      "User": []
    },

    "Features": {
      // EnableApiDocs 默认随环境变（Program.cs），此处勿写死
      "EnablePasswordFlow": false
    },

    "Cors": {
      "AllowedOrigins": []
    },

    // Provider: logging | smtp | ethereal-auto（仅 Development）
    "Email": {
      "Provider": "logging",
      "Host": "",
      "Port": 587,
      "UserName": "",
      "Password": "",
      "EnableSsl": true,
      "FromAddress": "",
      "FromName": "AuthHub",
      "TimeoutSeconds": 30
    },

    // Provider: logging | http（POST {phoneNumber,message} 到 HttpUrl）。
    // Development 下 logging 自动用内存收件箱，浏览器打开 /dev/sms-inbox 查看验证码。
    "Sms": {
      "Provider": "logging",
      "HttpUrl": "",
      "ApiKey": "",
      "TimeoutSeconds": 30
    },

    "Seeding": {
      "Enabled": false,
      "MigrateOnStartup": false,
      "AllowInProduction": false
    },

    "Keys": {
      "SigningCertificatePath": "",
      "SigningCertificatePassword": ""
    },

    "RateLimiting": {
      "TokenRequestsPerMinute": 60,
      "LoginRequestsPerMinute": 10
    },

    "Seed": {
      "AdminPassword": "",
      "DemoPassword": "",
      "WebClientSecret": "",
      "M2mClientSecret": ""
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/authhub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },

  "AllowedHosts": "*"
}
