<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AuthHub.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Infrastructure 需要 ASP.NET Core 共享框架，原因：
      1) Microsoft.AspNetCore.Identity.EntityFrameworkCore 的
         AddEntityFrameworkStores<TContext>() 返回 IdentityBuilder，定义在 ASP.NET Core Identity 内；
      2) Identity 的 Cookie 方案（IdentityConstants.ApplicationScheme）属于 Web 层概念。
      数据库 / 仓储 / OpenIddict 管理器实现本身不依赖 HTTP，无业务逻辑。
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      OpenIddict（加密/签名相关路径）会把 System.Security.Cryptography.Pkcs 作为传递依赖带进来，
      默认解析到 9.0.11 —— 该版本有已知中/高危漏洞（GHSA-2fmv-rv2c-59x7、GHSA-846f-f764-76mx），
      在 `-warnaserror` 下会以 NU1902/NU1903 直接卡死 CI。显式引用 10.0.13 把它顶上去。
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
    <!--
      OpenIddict.Validation.ServerIntegration 提供 UseLocalServer()：
      本服务同时是签发方与校验方，用服务端密钥在进程内直接校验令牌，
      无需走 introspection 回环请求。
    -->
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="7.7.2" />

    <!--
      Redis 令牌条目缓存（AuthHub:Redis，默认关闭）用 StackExchange.Redis 直连而不是
      IDistributedCache：失效设计需要原子的 INCR（全局版本号）与多键并行 GET（管线化），
      IDistributedCache 的抽象面不提供这两样。关闭时本包不产生任何连接。
    -->
    <PackageReference Include="StackExchange.Redis" Version="3.4.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthHub.Application\AuthHub.Application.csproj" />
    <ProjectReference Include="..\AuthHub.Domain\AuthHub.Domain.csproj" />
  </ItemGroup>

</Project>
